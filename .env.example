# --- read-only ---
HSK_RPC=https://mainnet.hsk.xyz

# --- live trading (all four required; nothing happens without them) ---
SENTINEL_LIVE=0
SENTINEL_VAULT=
SENTINEL_STRATEGY_KEY=
SENTINEL_RISK_KEY=
# One explicit opt-in before a non-loopback RPC can receive a transaction. A local anvil fork needs no flag.
SENTINEL_CONFIRM_MAINNET_TX=0
# Which pre-registered strategy the agent runs: trend_filtered | dislocation
SENTINEL_STRATEGY_MODE=trend_filtered

# --- deployment ---
SENTINEL_OWNER=
SENTINEL_STRATEGY_ADDR=
SENTINEL_RISK_ADDR=
DEPLOYER_KEY=

# --- swap guards (Uniswap skills): confirm | autonomous (autonomous needs caps + allowlist + dry run) ---
SENTINEL_GUARD_MODE=confirm

# --- x402 v2 paid endpoint / paid data ---
SENTINEL_X402_PAY_TO=
SENTINEL_X402_PRICE=1000
SENTINEL_X402_BUDGET=10000
SENTINEL_DATA_URL=
# paper (default) verifies the EIP-3009 authorization and writes a receipt; chain broadcasts it for real.
# chain refuses HSK mainnet unless SENTINEL_ALLOW_MAINNET_SPEND=1 or the RPC is loopback.
SENTINEL_X402_SETTLEMENT=paper
SENTINEL_X402_RPC=
SENTINEL_X402_FACILITATOR_KEY=
SENTINEL_X402_DEMO_KEY=
SENTINEL_X402_ASSET=
SENTINEL_X402_TOKEN_NAME=USDT
SENTINEL_X402_TOKEN_VERSION=1

# --- ERC-8004 registries (addresses only; no keys needed to read) ---
SENTINEL_8004_IDENTITY=
SENTINEL_8004_REPUTATION=
SENTINEL_8004_VALIDATION=
SENTINEL_8004_ADAPTER=
SENTINEL_8004_AGENT_ID=

# --- narrator: an OpenAI-compatible endpoint. It may narrate and propose; it can never move a number.
# Unset = the deterministic sentence is the answer (the product does not depend on a key).
SENTINEL_LLM_URL=
SENTINEL_LLM_MODEL=gpt-4o-mini
SENTINEL_LLM_API_KEY=
SENTINEL_LLM_TIMEOUT=10
# Offline demo/testing: a fixed scripted reply instead of an endpoint.
SENTINEL_LLM_SCRIPT=
